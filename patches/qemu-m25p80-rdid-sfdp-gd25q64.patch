+        } else if (s->cur_addr <= 1) {
+            /* Generic manufacturer/device ID (command 0x90) and electronic
+             * signature (command 0xAB), as real SPI NOR parts answer them.
+             * 0x90: addr 0 -> [manufacturer, device id],
+             *       addr 1 -> [device id, manufacturer].
+             * 0xAB: electronic signature (capacity byte of the JEDEC ID).
+             */
+            if (s->cmd_in_progress == RDID_AB) {
+                s->data[0] = s->pi->id[2];
+                s->len = 1;
+            } else if (s->cur_addr) {
+                s->data[0] = s->pi->id[1];
+                s->data[1] = s->pi->id[0];
+                s->len = 2;
+            } else {
+                s->data[0] = s->pi->id[0];
+                s->data[1] = s->pi->id[1];
+                s->len = 2;
+            }
+            s->pos = 0;
+            s->data_read_loop = true;
+            s->state = STATE_READING_DATA;
         } else {
             qemu_log_mask(LOG_GUEST_ERROR,
-                          "M25P80: Read id (command 0x90/0xAB) is not supported"
-                          " by device\n");
+                          "M25P80: Invalid read id address\n");
         }
         break;
 
